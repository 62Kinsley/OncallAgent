# Alibaba Bailian / DashScope (OpenAI-compatible mode)
OPENAI_API_KEY=your-bailian-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus

# Slack Incoming Webhook (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Adapters: keep true for free local demos (default)
USE_MOCK_ADAPTERS=true

# Only needed when USE_MOCK_ADAPTERS=false
AWS_REGION=us-west-2
# Optional overrides for CloudWatch cost/safety limits
CW_LOG_GROUP_PREFIX=/aws/service
CW_LOOKBACK_MINUTES=15
CW_MAX_LOG_EVENTS=20
