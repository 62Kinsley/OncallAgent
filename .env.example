# Alibaba Bailian / DashScope (OpenAI-compatible mode)
OPENAI_API_KEY=your-bailian-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus

# Slack Incoming Webhook (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Adapters: keep true for free local demos (default)
USE_MOCK_ADAPTERS=true

# Only needed when USE_MOCK_ADAPTERS=false
AWS_REGION=us-west-2
# Optional overrides for CloudWatch cost/safety limits
CW_LOG_GROUP_PREFIX=/aws/service
CW_LOOKBACK_MINUTES=15
CW_MAX_LOG_EVENTS=20

# Custom demo metrics (seed with scripts/seed_demo_metrics.sh)
CW_METRICS_NAMESPACE=OncallAgent/Demo
CW_METRICS_PERIOD_SECONDS=60
CW_BASELINE_ERROR_RATE_PCT=0.2
CW_BASELINE_P95_LATENCY_MS=180

# Optional teaching-only deploy context for live CloudWatch mode
CW_DEMO_DEPLOY_VERSION=v1.84.2
CW_DEMO_DEPLOYED_AT=2026-07-22T22:10:00Z
CW_DEMO_DEPLOY_CHANGE=timeout reduced from 3000ms to 300ms
